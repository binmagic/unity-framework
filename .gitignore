.idea/
.vs/
.vscode/
*.swp
*.swo
*~

# =============== #
#      XLua       #
# =============== #

# --- XLua Generated ---
Assets/Plugins/XLua/Gen/*
!Assets/Plugins/XLua/Gen/.gitkeep
Assets/Main/LuaTxt/*
Assets/Main/Scripts/XLuaGen/*

# --- XLua Examples (可选，如不需要可取消注释) ---
# Assets/XLua/Examples/

# --- Lua Source (如果 Lua 放在 StreamingAssets 外且不需要版本控制) ---
# Assets/Lua/*.lua.bytes
# Assets/Lua/*.meta

# --- XLua hotfix 生成文件 ---
Assets/XLua/Gen/*
!Assets/XLua/Gen/.gitkeep

# =============== #
#   Common Tools   #
# =============== #

# --- NuGet ---
*.nupkg
# packages/

# --- Gradle (Android) ---
*.gradle
.gradle/
local.properties

# --- Xcode (iOS) ---
*.xcworkspace
*.xcodeproj
Pods/
Podfile.lock

# --- TexturePacker ---
*.tps
atlas/

# --- Claude 知识库（本地，不入库）---
/requirements/history/
/requirements/knowledge/

# --- Claude 本地配置（含个人权限设置，不入库）---
/.claude/

# --- 构建产物 ---
/AssetBundles/

# --- 开发期验证截图（非美术资源）---
/Assets/Screenshots/
/Assets/Screenshots.meta

# --- 本地文档与素材（暂不入库）---
/Docs/
/Assets/Landscape/
/Assets/Landscape.meta
/Assets/images/
/Assets/images.meta

# --- Unity 打开示例场景时自动生成的光照设置 ---
*Settings.lighting
*Settings.lighting.meta

# --- 字体：origin/master 已有同名文件，等同步 master 时自然获得，避免 22M 重复 ---
/Assets/Main/Fonts/
/Assets/Main/Fonts.meta

# --- 空目录的孤儿 meta（对应目录内容已被忽略或不存在）---
/Assets/Main/Scripts/XLuaGen.meta
/Assets/Main/LuaScripts/Game/LianLian.meta
